//@version=6
indicator("AYAZ TREND V5 | GERCEK 4H | 15M 1H 4H", overlay=true, max_labels_count=100)

// ===========================================
// AYAZ TREND V5
// GERCEK 4H TREND MOTORU
// Grafik: 15m / 1H / 4H
// Trend: Sadece kapanmis 4H mumlari
// ===========================================

// 1 - AYARLAR

pivotLen = input.int(2, "4H Swing sag/sol", minval=1, maxval=8)

emaLen = input.int(55, "4H EMA", minval=10, maxval=200)
hmaLen = input.int(21, "4H HMA", minval=9, maxval=100)

stLen    = input.int(10,    "Supertrend ATR",    minval=5, maxval=30)
stFactor = input.float(3.0, "Supertrend katsayi", minval=1, maxval=6, step=0.25)

diLen     = input.int(14,   "DMI periyot",    minval=5)
adxSmooth = input.int(14,   "ADX yumusatma",  minval=5)
adxMin    = input.float(20, "Guclu trend ADX", minval=10, maxval=40)

srLen = input.int(20, "4H destek/direnc mum", minval=5, maxval=100)

showEMA     = input.bool(true,  "EMA goster")
showHMA     = input.bool(true,  "HMA goster")
showST      = input.bool(true,  "Supertrend goster")
showSR      = input.bool(true,  "Destek direnc goster")
showPanel   = input.bool(true,  "Trend paneli")
showBg      = input.bool(false, "Trend arka plani")
showSignals = input.bool(true,  "Trend degisimleri")

// 2 - GRAFIK KONTROLU

int  chartSeconds = timeframe.in_seconds()
bool validTF      = chartSeconds == 900 or chartSeconds == 3600 or chartSeconds == 14400

if barstate.isfirst
    if not chart.is_standard or not validTF
        runtime.error("Standart 15m, 1H veya 4H grafik kullanin.")

// 3 - GERCEK 4H HESAPLAMA
// Her fonksiyon tek deger dondurur (CE10112 onlemi).
// Durum gerektiren mainTrend ayri fonksiyonda, gostergeler tek degerli fonksiyonlarda.

// Ana trend - var ile durumu korur
f_trend4H() =>
    float ema = ta.ema(close, emaLen)
    float hma = ta.hma(close, hmaLen)

    [stLine, stDir]    = ta.supertrend(stFactor, stLen)
    [diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)

    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    float pl = ta.pivotlow(low,  pivotLen, pivotLen)

    float lastHigh = ta.valuewhen(not na(ph), ph, 0)
    float prevHigh = ta.valuewhen(not na(ph), ph, 1)
    float lastLow  = ta.valuewhen(not na(pl), pl, 0)
    float prevLow  = ta.valuewhen(not na(pl), pl, 1)

    bool structureUp   = not na(prevHigh) and not na(prevLow) and lastHigh > prevHigh and lastLow > prevLow
    bool structureDown = not na(prevHigh) and not na(prevLow) and lastHigh < prevHigh and lastLow < prevLow

    bool bosUp   = not na(lastHigh[1]) and close > lastHigh[1] and close[1] <= lastHigh[1]
    bool bosDown = not na(lastLow[1])  and close < lastLow[1]  and close[1] >= lastLow[1]

    bool momentumUp   = stDir < 0 and hma > hma[2] and diPlus > diMinus
    bool momentumDown = stDir > 0 and hma < hma[2] and diMinus > diPlus

    var int mainTrend = 0

    if bosUp and not bosDown
        mainTrend := 1
    else if bosDown and not bosUp
        mainTrend := -1
    else if mainTrend == 0
        if structureUp
            mainTrend := 1
        else if structureDown
            mainTrend := -1
        else if momentumUp and close > ema
            mainTrend := 1
        else if momentumDown and close < ema
            mainTrend := -1

    int(mainTrend[1])

// Gosterge fonksiyonlari - her biri tek deger dondurur

f_ema4H() => ta.ema(close, emaLen)[1]
f_hma4H() => ta.hma(close, hmaLen)[1]

f_stLine4H() =>
    [stLine, stDir] = ta.supertrend(stFactor, stLen)
    stLine[1]

f_stDir4H() =>
    [stLine, stDir] = ta.supertrend(stFactor, stLen)
    int(stDir[1])

f_diPlus4H() =>
    [diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)
    diPlus[1]

f_diMinus4H() =>
    [diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)
    diMinus[1]

f_adx4H() =>
    [diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)
    adx[1]

f_lastHigh4H() =>
    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    ta.valuewhen(not na(ph), ph, 0)[1]

f_lastLow4H() =>
    float pl = ta.pivotlow(low, pivotLen, pivotLen)
    ta.valuewhen(not na(pl), pl, 0)[1]

f_prevHigh4H() =>
    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    ta.valuewhen(not na(ph), ph, 1)[1]

f_prevLow4H() =>
    float pl = ta.pivotlow(low, pivotLen, pivotLen)
    ta.valuewhen(not na(pl), pl, 1)[1]

// 4 - 4H VERISI

trend4H   = request.security(syminfo.tickerid, "240", f_trend4H(),   lookahead=barmerge.lookahead_on)
ema4H     = request.security(syminfo.tickerid, "240", f_ema4H(),     lookahead=barmerge.lookahead_on)
hma4H     = request.security(syminfo.tickerid, "240", f_hma4H(),     lookahead=barmerge.lookahead_on)
st4H      = request.security(syminfo.tickerid, "240", f_stLine4H(),  lookahead=barmerge.lookahead_on)
stDir4H   = request.security(syminfo.tickerid, "240", f_stDir4H(),   lookahead=barmerge.lookahead_on)
diPlus4H  = request.security(syminfo.tickerid, "240", f_diPlus4H(),  lookahead=barmerge.lookahead_on)
diMinus4H = request.security(syminfo.tickerid, "240", f_diMinus4H(), lookahead=barmerge.lookahead_on)
adx4H     = request.security(syminfo.tickerid, "240", f_adx4H(),     lookahead=barmerge.lookahead_on)
high4H    = request.security(syminfo.tickerid, "240", f_lastHigh4H(),lookahead=barmerge.lookahead_on)
low4H     = request.security(syminfo.tickerid, "240", f_lastLow4H(), lookahead=barmerge.lookahead_on)

close4H     = request.security(syminfo.tickerid, "240", close[1],                   lookahead=barmerge.lookahead_on)
prevHigh4H  = request.security(syminfo.tickerid, "240", f_prevHigh4H(),             lookahead=barmerge.lookahead_on)
prevLow4H   = request.security(syminfo.tickerid, "240", f_prevLow4H(),              lookahead=barmerge.lookahead_on)
rangeHigh4H = request.security(syminfo.tickerid, "240", ta.highest(high, srLen)[1], lookahead=barmerge.lookahead_on)
rangeLow4H  = request.security(syminfo.tickerid, "240", ta.lowest(low,  srLen)[1],  lookahead=barmerge.lookahead_on)

// 5 - VERI KONTROLU

bool ready = not na(ema4H) and not na(hma4H) and not na(st4H) and not na(adx4H)

int direction = ready ? trend4H : 0

// 6 - 4H YAPI SINIFLANDIRMASI

bool structureBull = not na(prevHigh4H) and not na(prevLow4H) and high4H > prevHigh4H and low4H > prevLow4H
bool structureBear = not na(prevHigh4H) and not na(prevLow4H) and high4H < prevHigh4H and low4H < prevLow4H

string structureText = structureBull ? "HH / HL" : structureBear ? "LH / LL" : "KARISIK"

// 7 - TREND DURUMU

int shortDirection = stDir4H < 0 ? 1 : stDir4H > 0 ? -1 : 0

bool correction = direction == 1  and shortDirection == -1
bool rebound    = direction == -1 and shortDirection == 1

string trendText = not ready ? "VERI BEKLENIYOR" : direction == 1 ? "YUKSELIS" : direction == -1 ? "DUSUS" : "BELIRSIZ"

string phaseText = not ready ? "VERI YOK" : correction ? "ASAGI DUZELTME" : rebound ? "YUKARI TEPKI" : adx4H < adxMin ? "ZAYIF / YATAY" : "YONLE UYUMLU"

color trendColor = direction == 1 ? color.rgb(20, 145, 80) : direction == -1 ? color.rgb(205, 45, 55) : color.gray

// 8 - DESTEK VE DIRENC

float support    = not na(low4H)  and low4H  < close4H ? low4H  : rangeLow4H
float resistance = not na(high4H) and high4H > close4H ? high4H : rangeHigh4H

// 9 - YENI 4H MUM

bool new4H = timeframe.change("240")

bool changedUp   = ready and new4H and direction == 1  and direction[1] != 1
bool changedDown = ready and new4H and direction == -1 and direction[1] != -1

// 10 - TREND CIZGILERI

plot(showEMA ? ema4H : na, "4H EMA",        color=color.blue,   linewidth=2, style=plot.style_stepline)
plot(showHMA ? hma4H : na, "4H HMA",        color=color.orange, linewidth=2, style=plot.style_stepline)
plot(showST  ? st4H  : na, "4H Supertrend", color=shortDirection == 1 ? color.lime : color.red, linewidth=2, style=plot.style_stepline)

// 11 - DESTEK DIRENC CIZGILERI

plot(showSR ? support    : na, "4H Destek", color=color.green, linewidth=2, style=plot.style_stepline)
plot(showSR ? resistance : na, "4H Direnc", color=color.red,   linewidth=2, style=plot.style_stepline)

// 12 - ARKA PLAN

color bgColor = direction == 1 ? color.new(color.green, 94) : direction == -1 ? color.new(color.red, 94) : color.new(color.gray, 97)

bgcolor(showBg and ready ? bgColor : na)

// 13 - TREND DEGISIM ETIKETLERI

plotshape(showSignals and changedUp,   title="4H Yukselis", style=shape.labelup,   location=location.belowbar, color=color.green, text="4H UP",   textcolor=color.white, size=size.tiny)
plotshape(showSignals and changedDown, title="4H Dusus",    style=shape.labeldown, location=location.abovebar, color=color.red,   text="4H DOWN", textcolor=color.white, size=size.tiny)

// 14 - PANEL

int chartBarsPer4H = int(14400 / chartSeconds)

var table t = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast and showPanel
    color dark  = color.rgb(27, 37, 54)
    color rowBg = color.rgb(44, 54, 72)

    table.cell(t, 0, 0, "AYAZ V5",    text_color=color.white, bgcolor=dark)
    table.cell(t, 1, 0, "4H TREND",   text_color=color.white, bgcolor=dark)

    table.cell(t, 0, 1, "ANA YON",    text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 1, trendText,    text_color=color.white, bgcolor=trendColor)

    table.cell(t, 0, 2, "HAREKET",    text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 2, phaseText,    text_color=color.white, bgcolor=rowBg)

    table.cell(t, 0, 3, "4H YAPI",    text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 3, structureText, text_color=color.white, bgcolor=rowBg)

    table.cell(t, 0, 4, "SUPERTREND", text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 4, shortDirection == 1 ? "YUKARI" : "ASAGI", text_color=color.white, bgcolor=rowBg)

    table.cell(t, 0, 5, "DI+ / DI-",  text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 5, str.tostring(diPlus4H, "#.0") + " / " + str.tostring(diMinus4H, "#.0"), text_color=color.white, bgcolor=rowBg)

    table.cell(t, 0, 6, "4H ADX",     text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 6, str.tostring(adx4H, "#.0"), text_color=color.white, bgcolor=rowBg)

    table.cell(t, 0, 7, "DESTEK",     text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 7, str.tostring(support,    format.mintick), text_color=color.lime,   bgcolor=rowBg)

    table.cell(t, 0, 8, "DIRENC",     text_color=color.white, bgcolor=rowBg)
    table.cell(t, 1, 8, str.tostring(resistance, format.mintick), text_color=color.orange, bgcolor=rowBg)

// 15 - ALARMLAR

alertcondition(changedUp,   title="AYAZ 4H UP",   message="4H ana trend yukselise gecti: {{ticker}}")
alertcondition(changedDown, title="AYAZ 4H DOWN",  message="4H ana trend dususe gecti: {{ticker}}")

// ===========================================
// AYAZ TREND V5 - KOD SONU
// ===========================================
